{
  "name": "chatkit-inbox-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A unified inbox across WhatsApp, Telegram, Discord and Slack, built on @myrialabs/chatkit (Svelte 5 + Tailwind v4 + Elysia + Bun + SQLite).",
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "bun server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@myrialabs/chatkit": "file:../..",
    "elysia": "^1.1.25",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.5",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
