{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"types": ["vite/client", "bun"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "scripts/**/*.ts"],
	"exclude": ["node_modules/*", "dist/*"]
}
